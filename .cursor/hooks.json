{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node scripts/hooks/lint-changed.mjs"
      },
      {
        "command": "node scripts/hooks/guard-client-owner.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node scripts/hooks/guard-shell.mjs"
      }
    ]
  }
}
